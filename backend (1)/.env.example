NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
CLIENT_URL=https://faithblissafrica.com
PUBLIC_APP_URL=https://faithblissafrica.com
CORS_ALLOWED_ORIGINS=https://faithblissafrica.com,https://www.faithblissafrica.com

# Optional integrations (set only if used by deployed features)
JWT_SECRET=replace_with_secure_secret
SENDGRID_API_KEY=replace_with_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@example.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_BASE64=base64_encoded_service_account_json
