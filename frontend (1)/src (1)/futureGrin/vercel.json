{
  "redirects": [
    {
      "source": "/about-us/:path*",
      "destination": "https://www.futuregrin.com/about",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "futuregrin.com"
        }
      ],
      "destination": "https://www.futuregrin.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
